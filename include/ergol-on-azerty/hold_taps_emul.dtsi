#elifdef HT_HOME_ROW_MODS
  //#define EL_LTHUMB_TUCK   &EZ_SL(EL_SLAYER)
  //#define EL_LTHUMB_TUCK   &EL_dbltap_shift
  #define EL_LTHUMB_TUCK   &mo_EL_SLAYER_or_to_EL_SLAYER
  #define EL_LTHUMB_HOME   EL_LTHUMB_HRM
  #define EL_LTHUMB_REACH  &sc EL_HRM_LAYER REACH_TAP
  #define EL_RTHUMB_REACH  &sc EL_HRM_LAYER ENTER
  #define EL_RTHUMB_HOME   EL_RTHUMB_HRM
  #define EL_RTHUMB_TUCK   &EL_sym_shift_altgr

  #define EL_SHIFTED_LTHUMB_TUCK  &none //&td_to EL_LAYER
  #define EL_SHIFTED_LTHUMB_HOME  EL_SHIFTED_LTHUMB_HRM
 // #define EL_SHIFTED_LTHUMB_REACH &td_to_EL_LAYER

  #define EL_CAPSLOCK_LTHUMB_TUCK &mo_EL_SLAYER_or_to_EL_LAYER

  #define EL_SHIFTED_RTHUMB_REACH &kp LS(ENTER)
  #define EL_SHIFTED_RTHUMB_HOME  EL_SHIFTED_RTHUMB_HRM
  #define EL_SHIFED_RTHUMB_TUCK &sl EL_SSYMBOLS_LAYER

  #define EL_NAVNUM_RTHUMB_TUCK  &sl_mo EL_SNUM_NAV_LAYER EL_SNUM_NAV_LAYER
#elifdef HT_TWO_THUMB_KEYS

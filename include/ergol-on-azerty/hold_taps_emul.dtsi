  #define EL_RTHUMB_S34 &lt EL_S34_LAYER SPACE
 // #define EL_SHIFTED_LTHUMB_HRM &sc EL_SNUM_NAV_LAYER BACKSPACE
  #define EL_SHIFTED_RTHUMB_HRM &lt EL_SNUM_NAV_LAYER LS(SPACE)
  #define EL_SHIFTED_LTHUMB_HRM &lt EL_NUM_NAV_LAYER BACKSPACE

  #define EL_LTHUMB_HOME   EL_LTHUMB_S34
  #define EL_LTHUMB_REACH  EL_LTHUMB_TUCK
  #define EL_RTHUMB_REACH  &sc EL_SYMBOLS_LAYER ENTER
  #define EL_RTHUMB_HOME   EL_RTHUMB_S34
  #define EL_RTHUMB_TUCK   EL_RTHUMB_REACH
#endif

#define EL_X_UNDO  &kp CMD(W)
#define EL_X_CUT   &kp CMD(X)
#define EL_X_COPY  &kp CMD(C)
#define EL_X_PASTE &kp CMD(V)
#define EL_X_REDO  &kp CMD(Y)

#define EL_X_CLOSE &kp CMD(Z)
#define EL_X_SAVE  &kp CMD(S)
#define EL_X_ALL   &kp CMD(Q)

//#define EZ_SL(layer)  bsl (layer) (layer)
//#define EZ_SK(mod)    bsk (mod) (mod)
//#define EL_EZ_LSK(mod)   lbsk (mod) (mod)

/ {
  behaviors {

    // mod-morphs to restore Shift+Space and Ctrl+Backspace for certain keymaps
    EL_magic_backspace: EL_magic_backspace {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&sc EL_NAV_LAYER BACKSPACE>, <&lt EL_NAV_LAYER SPACE>;
      mods      = <MOD_LSFT>;
      keep-mods = <MOD_LSFT>;
    };
    EL_Emagic_space: EL_magic_space {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&lt EL_NAV_LAYER SPACE>, <&sc EL_NAV_LAYER BACKSPACE>;
      mods      = <MOD_LCTL>;
      keep-mods = <MOD_LCTL>;
    };
    EL_magic_backspace_34_keys: EL_magic_backspace_34_keys {
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&sc EL_HRM_LAYER BACKSPACE>, <&lt EL_HRM_LAYER SPACE>;
      mods      = <MOD_LSFT>;
      keep-mods = <MOD_LSFT>;
    };

  // XXX this whole AltGr section should probably be inside the `behaviors` branch
  // AltGr support

  // Sym becomes Shift+AltGr when combined with exclusively Shift
  EL_sym_shift_altgr: EL_sym_shift_altgr {
    compatible = "zmk,behavior-mod-morph";
    #binding-cells = <0>;
    bindings = <&EL_sym_shift_altgr_inner>, <&EZ_SL(EL_SYMBOLS_LAYER)>;
    mods      = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI|MOD_LALT)>;
    keep-mods = <(MOD_LCTL|MOD_RCTL|MOD_LGUI|MOD_RGUI|MOD_LALT)>;
  };
  EL_sym_shift_altgr_inner: EL_sym_shift_altgr_inner {
    compatible = "zmk,behavior-mod-morph";
    #binding-cells = <0>;
    bindings = <&EZ_SL(EL_SYMBOLS_LAYER)>, <&EZ_SK(RALT)>;
    mods      = <(MOD_LSFT|MOD_RSFT)>;
    keep-mods = <(MOD_LSFT|MOD_RSFT)>;
  };

  // go to base layer and press mod

  EL_lkp: EL_goto_layer_then_keypress {
    compatible = "zmk,behavior-macro-one-param";
    wait-ms = <0>;
    tap-ms = <0>;
    #binding-cells = <1>;
    bindings =
      <&macro_tap &to EL_LAYER>,
      <&macro_param_1to1>,
      <&macro_press &kp MACRO_PLACEHOLDER>,
      <&macro_pause_for_release>,
      <&macro_param_1to1>,
      <&macro_release &kp MACRO_PLACEHOLDER>;
  };
  EL_losm: EL_goto_layer_then_osm {
    compatible = "zmk,behavior-macro-one-param";
    wait-ms = <0>;
    tap-ms = <0>;
    #binding-cells = <1>;
    bindings =
      <&macro_tap &to EL_LAYER>,
      <&macro_param_1to1>,
      <&macro_tap &sk MACRO_PLACEHOLDER>;
  };
  EL_lbsk: EL_bsk_on_other_layer {
    compatible = "zmk,behavior-hold-tap";
    #binding-cells = <2>;
    tapping-term-ms = <TAPPING_TERM>;
    flavor = "tap-preferred";
    bindings = <&EL_lkp>, <&EL_losm>;
  };
// pour émuler la touche morte, un sticky layer sans timeout
  sl_no_timeout: sl_no_timeout {
    compatible = "zmk,behavior-sticky-layer";
    #binding-cells = <1>;
    release-after-ms = <0>;
    quick-release;      // optionnel
  };
// pour ajout shift depuis nav
// probablement à améliorer
// À renommer pour être cohérent avec le reste
// reste à implémenter le double shift=capslock
  sl_mo: sticky_layer_momentary {
    compatible = "zmk,behavior-hold-tap";
    #binding-cells = <2>;
    flavor = "hold-preferred";
    tapping-term-ms = <SHORT_TAPPING_TERM>;
    //tapping-term-ms = <120>;
    hold-while-undecided;
    bindings = <&mo>, <&sl>;
  };
// pour ajout shift - double tap/caplock
//  sl_mo_EL_SLAYER: sl_mo_EL_SLAYER {
//    compatible = "zmk,behavior-hold-tap";
//    #binding-cells = <0>;
//    flavor = "balanced";
//    tapping-term-ms = <200>;
//    quick-tap-ms = <200>;
//    bindings = <&mo>, <&sl>;
//  };
//  EL_dbltap_shift: EL_dbltap_shift {
//    compatible = "zmk,behavior-tap-dance";
//    #binding-cells = <0>;
//    tapping-term-ms = <TAPPING_TERM>;
    //tapping-term-ms = <100>;
//    bindings = <&sl_mo EL_SLAYER EL_SLAYER>, <&to EL_SLAYER >;
//  };
//  td_to_EL_LAYER: td_to_EL_LAYER {
//    compatible = "zmk,behavior-tap-dance";
//    #binding-cells = <0>;
//    tapping-term-ms = <TAPPING_TERM>;
//    bindings = <&none>, <&to EL_LAYER>;
//        };


  td_to_EL_CAPSLOCK_SLAYER: td_to_EL_CAPSLOCK_SLAYER {
    compatible = "zmk,behavior-tap-dance";
    #binding-cells = <0>;
    tapping-term-ms = <200>;
    bindings = <&none>, <&to EL_CAPSLOCK_LAYER>;
  };

  mo_EL_SLAYER_or_to_EL_SLAYER: mo_EL_SLAYER_or_to_EL_SLAYER{
    compatible = "zmk,behavior-hold-tap";
    #binding-cells = <0>;
    flavor = "hold-preferred";
    tapping-term-ms = <120>;
    hold-while-undecided;
    bindings = <&mo EL_SLAYER>, <&td_to_EL_CAPSLOCK_SLAYER>;
  };

  td_to_EL_LAYER: td_to_EL_LAYER {
    compatible = "zmk,behavior-tap-dance";
    #binding-cells = <0>;
    tapping-term-ms = <200>;
    bindings = <&none>, <&to EL_LAYER>;
  };

    mo_EL_SLAYER_or_to_EL_LAYER: mo_EL_SLAYER_or_to_EL_LAYER{
    compatible = "zmk,behavior-hold-tap";
    #binding-cells = <0>;
    flavor = "hold-preferred";
    tapping-term-ms = <120>;
    hold-while-undecided;
    bindings = <&mo EL_SLAYER>, <&td_to_EL_LAYER>;
  };


 };
};
